<?xml version="1.0" encoding="utf-8"?>
<resources>
    <bool name="light_bars">false</bool>

    <style name="Base.AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:colorPrimary">@color/page</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- API 26 can't darken the navigation buttons, so it gets a scrim; v27 clears it. -->
        <item name="android:navigationBarColor">@color/nav_bar_api26</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
    </style>
</resources>
